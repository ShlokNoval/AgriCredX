# AgriCredX Frontend Environment Variables
# Copy to .env.local for local development. NEVER commit .env.local!

# Supabase (Browser-safe publishable key)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Smart Contracts (populated after deployment)
VITE_INVOICE_REGISTRY_ADDRESS=
VITE_ATTESTATION_REGISTRY_ADDRESS=
VITE_FINANCING_POOL_ADDRESS=
VITE_REPAYMENT_MANAGER_ADDRESS=

# MST Blockchain Testnet
VITE_MST_CHAIN_ID=91562037
VITE_MST_RPC_URL=https://testnetrpc.mstblockchain.com
VITE_MST_EXPLORER_URL=https://mstscan.com
