# ============================================================
# AgriCredX — Environment Variables
# ============================================================
# Copy this file to .env and fill in real values.
# NEVER commit .env, .env.local, or any file containing secrets.
# ============================================================


# ============================================================
# MST Blockchain
# ============================================================

MST_RPC_URL=https://testnetrpc.mstblockchain.com
MST_CHAIN_ID=91562037
MST_EXPLORER_URL=https://mstscan.com
MST_NETWORK=testnet


# ============================================================
# Blockchain Deployer
# SERVER / LOCAL ONLY — NEVER EXPOSE TO FRONTEND
# ============================================================

DEPLOYER_PRIVATE_KEY=<LOCAL_SECRET_ONLY_NEVER_COMMIT>


# ============================================================
# Supabase — Public / Browser
# Safe to expose through the frontend when RLS is correctly configured
# ============================================================

VITE_SUPABASE_URL=<SUPABASE_PROJECT_URL>
VITE_SUPABASE_PUBLISHABLE_KEY=<SUPABASE_PUBLISHABLE_KEY>


# ============================================================
# Supabase — Server / Edge Functions ONLY
# NEVER expose these through VITE_ variables
# ============================================================

SUPABASE_URL=<SUPABASE_PROJECT_URL>
SUPABASE_SECRET_KEY=<SUPABASE_SECRET_KEY>


# ============================================================
# AI Service
# ============================================================

AI_SERVICE_URL=<PYTHON_AI_SERVICE_URL>
AI_SERVICE_KEY=<SERVER_SIDE_SECRET_ONLY>
GEMINI_API_KEY=<GEMINI_API_KEY_SERVER_SIDE_ONLY>


# ============================================================
# Contract Addresses — Server / Contract Integration
# Filled after MST deployment
# ============================================================

INVOICE_REGISTRY_ADDRESS=<DEPLOYED_AFTER_DEPLOYMENT>
ATTESTATION_REGISTRY_ADDRESS=<DEPLOYED_AFTER_DEPLOYMENT>
FINANCING_POOL_ADDRESS=<DEPLOYED_AFTER_DEPLOYMENT>
REPAYMENT_MANAGER_ADDRESS=<DEPLOYED_AFTER_DEPLOYMENT>


# ============================================================
# Contract Addresses — Frontend
# VITE_ variables are intentionally exposed to the browser
# ============================================================

VITE_INVOICE_REGISTRY_ADDRESS=<DEPLOYED_AFTER_DEPLOYMENT>
VITE_ATTESTATION_REGISTRY_ADDRESS=<DEPLOYED_AFTER_DEPLOYMENT>
VITE_FINANCING_POOL_ADDRESS=<DEPLOYED_AFTER_DEPLOYMENT>
VITE_REPAYMENT_MANAGER_ADDRESS=<DEPLOYED_AFTER_DEPLOYMENT>

VITE_MST_CHAIN_ID=91562037
VITE_MST_RPC_URL=https://testnetrpc.mstblockchain.com
VITE_MST_EXPLORER_URL=https://mstscan.com