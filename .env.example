# ============================================================
# AgriCredX - Environment Variables
# ============================================================
# Copy this file to .env and fill in real values.
# NEVER commit .env, .env.local, or any file containing secrets.
# ============================================================

# ============================================================
# MST Blockchain
# ============================================================
VITE_LOCAL_RPC_URL=http://127.0.0.1:8545
VITE_LOCAL_CHAIN_ID=31337

VITE_MST_RPC_URL=https://testnetrpc.mstblockchain.com
VITE_MST_CHAIN_ID=91562037
VITE_MST_EXPLORER_URL=https://mstscan.com

DEPLOYER_PRIVATE_KEY=<LOCAL_OR_MST_SECRET_NEVER_COMMIT>
MST_NETWORK=testnet

# ============================================================
# Supabase - Public / Browser
# ============================================================
VITE_SUPABASE_URL=<SUPABASE_PROJECT_URL>
VITE_SUPABASE_PUBLISHABLE_KEY=<SUPABASE_PUBLISHABLE_KEY>

# ============================================================
# Supabase - Server / Edge Functions ONLY
# ============================================================
SUPABASE_URL=<SUPABASE_PROJECT_URL>
SUPABASE_SECRET_KEY=<SUPABASE_SECRET_KEY>

# ============================================================
# AI Service
# ============================================================
AI_SERVICE_URL=<PYTHON_AI_SERVICE_URL>
AI_SERVICE_KEY=<SERVER_SIDE_SECRET_ONLY>
GEMINI_API_KEY=<GEMINI_API_KEY_SERVER_SIDE_ONLY>

# ============================================================
# Contract Addresses (Local or MST)
# ============================================================
VITE_AGRICREDX_CONTRACT_ADDRESS=<DEPLOYED_CONTRACT_ADDRESS>
